{
  "tasks": {
    "run": "deno run -A --no-config src/main.ts",
    "test": "deno test -A --no-config src",
    "check": "deno check --no-config src/main.ts",
    "lint": "deno lint --no-config src",
    "fmt:check": "deno fmt --check src",
    "verify": "deno fmt --check src && deno check --no-config src/main.ts && deno lint --no-config src && deno test -A --no-config src"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/cli/parse-args": "jsr:@std/cli@1/parse-args"
  },
  "fmt": { "lineWidth": 100, "indentWidth": 2, "semiColons": true },
  "lint": { "rules": { "tags": ["recommended"] } }
}
