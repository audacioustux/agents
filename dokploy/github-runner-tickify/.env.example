# Copied to `.env` beside compose.yml on the production runner's VM (README,
# "Deploy"); this runner is not deployed by Dokploy.

TICKIFY_REPO_URL=https://github.com/stage-crew/tickify

# The image by digest, never a moving tag: this runner executes with the
# production secrets. Resolve it once with
# `docker buildx imagetools inspect myoung34/github-runner:ubuntu-noble` and
# write it as myoung34/github-runner@sha256:<digest>.
RUNNER_IMAGE_REF=

# Absolute host path of the file holding this runner's own access token
# (../github-runner/README.md, "Registration credential").
TICKIFY_ACCESS_TOKEN_FILE=/etc/github-runner-tickify/access-token
