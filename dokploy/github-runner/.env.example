# Repo the tickify pool serves.
REPO_URL=https://github.com/stage-crew/tickify

# Fine-grained or classic PAT with repo admin (administration:write) on the
# target repo — the image self-mints short-lived registration tokens from
# it, so registration survives restarts without manual token refresh.
# Change: an unquoted "# …" after the `=` would be read as the value.
ACCESS_TOKEN=

# The same, for the Optics pool: admin (administration:write) on
# nobinalo/Optics. A fine-grained PAT covers one owner, so this is a second
# token; a classic PAT of a user who admins both repos may be pasted in both.
# Set it before the first deploy that includes runner-optics: while it is
# empty, the whole stack fails to deploy and the running pools stay as they
# are.
OPTICS_ACCESS_TOKEN=
