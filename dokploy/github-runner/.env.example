# Repo the tickify pool serves; the thegrid pool's URL is fixed in
# compose.yml.
REPO_URL=https://github.com/stage-crew/tickify

# Fine-grained or classic PAT with repo admin (administration:write) on BOTH
# target repos — the image self-mints short-lived registration tokens from
# it, so registration survives restarts without manual token refresh.
ACCESS_TOKEN= # change
