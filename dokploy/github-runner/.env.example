# --- tickify pool (repo-scoped) ---
# Repo the pool serves.
REPO_URL=https://github.com/stage-crew/tickify

# Fine-grained or classic PAT with repo admin (administration:write) on the
# target repo. The image self-mints short-lived registration tokens from it,
# so registration survives restarts without manual token refresh.
ACCESS_TOKEN= # change

# --- nobinalo pool (org-scoped) ---
# PAT with admin:org (classic) or org-level "Self-hosted runners: write"
# (fine-grained) on the nobinalo org. The pool's replicas stay at 0 in
# compose.yml until this is set.
NOBINALO_ACCESS_TOKEN=
