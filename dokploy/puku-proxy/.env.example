# Required. Comma-separated bearer tokens the proxy accepts.
# The proxy refuses to start without this set — fail-closed.
PUKU_PROXY_AUTH_KEYS=pk_live_replace_me

# Optional. Upstream Puku auth forwarded to puku-cli. The CLI may reject
# env-var keys with "Not logged in"; if that happens you'll need to run
# `puku-cli auth login` interactively once on the Dokploy host and bake
# the resulting state into a custom image, or contact Puku for an auth
# mode that accepts env vars.
PUKU_AI_API_KEY=

# Optional. Override the upstream SDK gateway URL.
PUKU_BASE_URL=

# Required. Port puku-proxy listens on inside the container and publishes
# to the dokploy-network host.
PORT=8787

# Optional. Set to 1 (or true / yes) to turn on verbose debug logging.
# Off by default. When on, every /v1/chat/completions request gets a
# [chat-N] prefix and the proxy logs signal state, heartbeat count, and
# the abort reason when an error fires. Useful for diagnosing streaming
# aborts and SDK transport issues — paste the log into a bug report.
PUKU_PROXY_DEBUG=
