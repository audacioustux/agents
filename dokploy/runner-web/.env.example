INITIAL_PASSWORD= # change

PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/app/data
NEXT_PUBLIC_BASE_URL=https://omni... # change
REDIS_URL=redis

OMNIROUTE_MEMORY_MB=8192
NODE_OPTIONS=--max-old-space-size=8192

OMNIROUTE_CHAT_HEAP_SHED_RATIO=0.75
OMNIROUTE_CHAT_LARGE_BODY_BYTES=262144
OMNIROUTE_CHAT_HARD_MAX_BODY_BYTES=52428800
OMNIROUTE_MAX_NONSTREAMING_RESPONSE_BYTES=67108864
OMNIROUTE_CHAT_HEAVY_MESSAGE_COUNT=400
OMNIROUTE_CHAT_HEAVY_TOOL_COUNT=64
OMNIROUTE_CHAT_HEAVY_ESTIMATED_TOKENS=32000
OMNIROUTE_CHAT_HARD_MAX_MESSAGES=1600
OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=4

# Master cap for the whole request. Cascades to the upstream fetch,
# stream-idle, and /v1 bridge timeouts.
REQUEST_TIMEOUT_MS=3000000

# Total upstream request timeout. Its default (600000) is what produced
# your 504 — the "response headers" timeout inherits from this one.
FETCH_TIMEOUT_MS=3000000

# Max silence between streamed chunks before aborting. Above the 600000
# default so long reasoning gaps don't trip it, but low enough to still
# catch a genuinely dead stream.
STREAM_IDLE_TIMEOUT_MS=1800000
