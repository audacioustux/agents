{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "lanes": "deno run -A src/main.ts",
    "test": "deno test -A",
    "ok": "deno fmt --check && deno lint && deno check src/*.ts && deno test -A"
  },
  "fmt": {
    "lineWidth": 120
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
